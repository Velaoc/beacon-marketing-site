<% title "Beacon — Ship features people actually use" %>
<% description "Beacon turns feature usage into a roadmap: capture events, see what matters, and ship with confidence." %>

<main id="main-content">
  <!-- Hero -->
  <section class="md-hero" aria-labelledby="hero-title">
    <div class="md-hero__inner">
      <div>
        <p class="md-section__eyebrow">Beacon</p>
        <h1 id="hero-title" class="md-hero__title">Ship features people actually use.</h1>
        <p class="md-hero__lede">Beacon plugs into your product and turns raw usage into a roadmap. See which features earn their keep, which ones are dead weight, and what your users reach for next — without another dashboard to babysit.</p>
        <div class="md-actions">
          <%= link_to "Get early access", "#signup", class: "md-button md-button--filled" %>
          <%= link_to "See how it works", "#features", class: "md-button md-button--outlined" %>
        </div>
        <p class="md-caption">Free during the beta. No credit card.</p>
      </div>
      <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
    </div>
  </section>

  <!-- Features -->
  <section class="md-section" id="features" aria-labelledby="features-title">
    <div class="md-section__inner">
      <p class="md-section__eyebrow">Features</p>
      <h2 id="features-title" class="md-section__heading">Everything you need to know what matters.</h2>
      <div class="md-grid">
        <article class="md-card md-card--filled md-feature">
          <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:insights, size: 32) %></span>
          <div>
            <h3>Event capture</h3>
            <p>Drop a single SDK line into your app. Beacon records feature usage, button clicks, and flows — no schema wrangling, no event taxonomy meetings.</p>
          </div>
        </article>
        <article class="md-card md-card--filled md-feature">
          <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:query_stats, size: 32) %></span>
          <div>
            <h3>Usage heatmaps</h3>
            <p>See which screens and actions your users actually touch. Spot the feature you built that nobody opens, before it becomes a liability.</p>
          </div>
        </article>
        <article class="md-card md-card--filled md-feature">
          <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:route, size: 32) %></span>
          <div>
            <h3>Adoption funnels</h3>
            <p>From first visit to power user. Beacon shows where people drop off, so you can fix the handoff instead of guessing at it.</p>
          </div>
        </article>
        <article class="md-card md-card--filled md-feature">
          <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:bolt, size: 32) %></span>
          <div>
            <h3>No dashboards to babysit</h3>
            <p>One page, updated daily, in plain English. Ask "what changed?" and get an answer, not a query language.</p>
          </div>
        </article>
        <article class="md-card md-card--filled md-feature">
          <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:group, size: 32) %></span>
          <div>
            <h3>Privacy-first by design</h3>
            <p>No cross-site tracking, no adtech. Event data belongs to you, is aggregated on your terms, and can be exported or deleted on request.</p>
          </div>
        </article>
        <article class="md-card md-card--filled md-feature">
          <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:extension, size: 32) %></span>
          <div>
            <h3>Plays nice with your stack</h3>
            <p>SDKs for Rails, Node, and React, plus a webhook feed that pushes into Slack, Linear, or whatever you already run.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="md-section" id="pricing" aria-labelledby="pricing-title">
    <div class="md-section__inner">
      <p class="md-section__eyebrow">Pricing</p>
      <h2 id="pricing-title" class="md-section__heading">Simple pricing that scales with you.</h2>
      <div class="md-grid md-grid--3">
        <article class="md-card md-card--filled">
          <h3>Starter</h3>
          <p class="md-price">$0</p>
          <p>For side projects finding their feet.</p>
          <ul class="md-list">
            <li>Up to 10k events / month</li>
            <li>1 product</li>
            <li>7-day retention</li>
            <li>Community support</li>
          </ul>
          <%= link_to "Start free", "#signup", class: "md-button md-button--outlined" %>
        </article>
        <article class="md-card md-card--filled md-card--featured">
          <h3>Pro</h3>
          <p class="md-price">$49<span>/mo</span></p>
          <p>For teams shipping every week.</p>
          <ul class="md-list">
            <li>1M events / month</li>
            <li>Unlimited products</li>
            <li>12-month retention</li>
            <li>Funnels &amp; heatmaps</li>
            <li>Priority support</li>
          </ul>
          <%= link_to "Get early access", "#signup", class: "md-button md-button--filled" %>
        </article>
        <article class="md-card md-card--filled">
          <h3>Scale</h3>
          <p class="md-price">Custom</p>
          <p>For orgs with serious volume.</p>
          <ul class="md-list">
            <li>Unlimited events</li>
            <li>SSO &amp; audit logs</li>
            <li>Data residency</li>
            <li>Dedicated support</li>
          </ul>
          <%= link_to "Talk to us", "#signup", class: "md-button md-button--outlined" %>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="md-section" id="faq" aria-labelledby="faq-title">
    <div class="md-section__inner">
      <p class="md-section__eyebrow">FAQ</p>
      <h2 id="faq-title" class="md-section__heading">Questions, answered.</h2>
      <div class="md-faq">
        <details class="md-faq__item">
          <summary>How is Beacon different from an analytics suite?</summary>
          <p>Analytics tools answer "how many people came". Beacon answers "what did they actually do with what I built". It's focused on feature-level adoption and the decisions that come out of it, not vanity traffic numbers.</p>
        </details>
        <details class="md-faq__item">
          <summary>Do I need to instrument everything?</summary>
          <p>No. Drop in the SDK, and Beacon starts tracking core interactions automatically. You can add named events for the flows that matter most — usually fewer than a dozen.</p>
        </details>
        <details class="md-faq__item">
          <summary>What happens to my data?</summary>
          <p>Your event data is yours. It's stored encrypted, never sold, never shared with ad networks. You can export a full copy or delete it at any time.</p>
        </details>
        <details class="md-faq__item">
          <summary>When does the beta start?</summary>
          <p>Beta access rolls out over the next few weeks, in the order people sign up. Drop your email below and you'll get an invite and a launch note when it's live.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Signup -->
  <section class="md-section" id="signup" aria-labelledby="signup-title">
    <div class="md-section__inner">
      <div class="md-card md-card--filled md-signup">
        <p class="md-section__eyebrow">Early access</p>
        <h2 id="signup-title" class="md-section__heading">Be first in line.</h2>
        <p>Join the list for beta access, launch notes, and honest updates — no spam, unsubscribe anytime.</p>

        <% if notice.present? %>
          <p class="md-callout md-callout--success" role="status"><%= notice %></p>
        <% elsif alert.present? %>
          <p class="md-callout md-callout--error" role="alert"><%= alert %></p>
        <% end %>

        <%= form_with model: @lead, url: leads_path, local: true, class: "md-form" do |f| %>
          <div class="md-field">
            <%= f.label :name, "Name (optional)" %>
            <%= f.text_field :name, autocomplete: "name", placeholder: "Ada Lovelace" %>
          </div>
          <div class="md-field">
            <%= f.label :email, "Email" %>
            <%= f.email_field :email, required: true, autocomplete: "email", placeholder: "ada@example.com" %>
          </div>
          <div class="md-field">
            <%= f.submit "Join the list", class: "md-button md-button--filled" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</main>
